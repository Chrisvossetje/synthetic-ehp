{
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "scripts": {
    "init": "rm -r -f ./_site && rm -r -f ./site/pkg && cp -r ./site/static ./_site",
    "build": "npm run init && esbuild ./site/src/main.ts --bundle --loader:.txt=text --outdir=./_site --entry-names=index --chunk-names=chunks/[name]-[hash] --splitting --format=esm --target=es2016",
    "minify": "npm run init && esbuild ./site/src/main.ts --bundle --loader:.txt=text --outdir=./_site --entry-names=index --chunk-names=chunks/[name]-[hash] --splitting --format=esm --target=es2016 --minify",
    "minify_alt": "esbuild ./site/src/main.ts --bundle --loader:.txt=text --outdir=./_site --entry-names=index --chunk-names=chunks/[name]-[hash] --splitting --format=esm --target=es2016 --minify",
    "watch": "npm run init && esbuild ./site/src/main.ts --bundle --loader:.txt=text --outdir=./_site --entry-names=index --chunk-names=chunks/[name]-[hash] --splitting --format=esm --target=es2016 --watch",
    "typecheck": "tsc -p ./site/src",
    "test:multiplications": "node --test tests/multiplicationTable.test.mjs",
    "test:names": "node --test tests/tagNames.test.mjs",
    "test": "npm run typecheck && npm run test:multiplications && npm run test:names"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0"
  }
}
